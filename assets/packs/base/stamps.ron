// Small 3D shapes for features.ron. `layers` run bottom to top; each layer is rows of
// characters read like a map (first row is the highest y, x runs left to right), all the
// same size. A space leaves the world alone. The middle column stands on the chosen cell.
[
    (id: "tree",
        layers: [
            ["   ", " T ", "   "],
            ["   ", " T ", "   "],
            ["lll", "lTl", "lll"],
            [" l ", "lll", " l "],
        ],
        legend: { 'T': "log", 'l': "leaves" }),

    (id: "tall_tree",
        layers: [
            ["   ", " T ", "   "],
            ["   ", " T ", "   "],
            ["   ", " T ", "   "],
            ["lll", "lTl", "lll"],
            ["lll", "lTl", "lll"],
            ["   ", " l ", "   "],
        ],
        legend: { 'T': "log", 'l': "leaves" }),

    (id: "boulder",
        layers: [
            ["ss", "ss"],
            ["s ", "  "],
        ],
        legend: { 's': "stone" }),

    // One-cell props.
    (id: "tuft",     layers: [["g"]], legend: { 'g': "tuft" }),
    (id: "flower",   layers: [["f"]], legend: { 'f': "flower" }),
    (id: "bluebell", layers: [["b"]], legend: { 'b': "bluebell" }),
    (id: "mushroom", layers: [["m"]], legend: { 'm': "mushroom" }),
    (id: "pebbles",  layers: [["p"]], legend: { 'p': "pebbles" }),
]
