    (id: "torch",      shape: "torch",      hp: 0.5, drops: Some("torch"), solid: false, light: Some(6.0), xp: 0.0),
    // Ramps let you climb a terrace; natural ones are placed at cliff feet by the generator.
    (id: "ramp",         shape: "ramp",         hp: 0.4, solid: false, xp: 0.0),

    // Decor: walkable, breaks instantly, no drops. Scattered by worldgen for texture.
    (id: "grass_tuft",   shape: "grass_tuft",   hp: 0.1, solid: false, xp: 0.0, jitter: 0.35),
    (id: "flower_white", shape: "flower_white", hp: 0.1, solid: false, xp: 0.0, jitter: 0.35),
    (id: "flower_red",   shape: "flower_red",   hp: 0.1, solid: false, xp: 0.0, jitter: 0.35),
