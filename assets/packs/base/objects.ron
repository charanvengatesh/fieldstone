// Things standing on tiles. `hardness` is the tool power needed; 0 means bare hands work.
// `tool` restricts which tool tag can damage it; omit it to allow anything.
[
    (id: "tree",       shape: "tree",       hp: 3.0, drops: Some("tree"), radius: 0.2, jitter: 0.22),
    (id: "stump",      shape: "stump",      hp: 2.0, drops: Some("stump"), radius: 0.3),
    (id: "oak",        shape: "oak",        hp: 7.0, drops: Some("oak"), radius: 0.5, size: (2, 2)),
    (id: "bush",       shape: "bush",       hp: 1.0, drops: Some("bush"), solid: false, jitter: 0.25),
    (id: "rock",       shape: "rock",       hp: 3.0, drops: Some("rock"), radius: 0.38, jitter: 0.2),
    (id: "iron_ore",   shape: "iron_ore",   hp: 4.0, drops: Some("iron_ore"), tool: Some("pickaxe"), hardness: 1, radius: 0.4, jitter: 0.12),
    (id: "coal_ore",   shape: "coal_ore",   hp: 3.0, drops: Some("coal_ore"), tool: Some("pickaxe"), hardness: 1, radius: 0.4, jitter: 0.12),
    (id: "gold_ore",   shape: "gold_ore",   hp: 5.0, drops: Some("gold_ore"), tool: Some("pickaxe"), hardness: 2, radius: 0.4, jitter: 0.12),

