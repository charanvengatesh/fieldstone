// Things standing on tiles. `hardness` is the tool power needed; 0 means bare hands work.
// `tool` restricts which tool tag can damage it; omit it to allow anything.
[
    (id: "tree",       shape: "tree",       hp: 3.0, drops: Some("tree"), radius: 0.2),
    (id: "bush",       shape: "bush",       hp: 1.0, drops: Some("bush"), solid: false),
    (id: "rock",       shape: "rock",       hp: 3.0, drops: Some("rock"), radius: 0.38),
    (id: "iron_ore",   shape: "iron_ore",   hp: 4.0, drops: Some("iron_ore"), tool: Some("pickaxe"), hardness: 1, radius: 0.4),
    (id: "coal_ore",   shape: "coal_ore",   hp: 3.0, drops: Some("coal_ore"), tool: Some("pickaxe"), hardness: 1, radius: 0.4),
    (id: "gold_ore",   shape: "gold_ore",   hp: 5.0, drops: Some("gold_ore"), tool: Some("pickaxe"), hardness: 2, radius: 0.4),

    (id: "wall_wood",  shape: "wall_wood",  hp: 2.0, drops: Some("wall_wood")),
    (id: "wall_stone", shape: "wall_stone", hp: 4.0, drops: Some("wall_stone"), tool: Some("pickaxe")),
    (id: "workbench",  shape: "workbench",  hp: 2.0, drops: Some("workbench"), station: Some("workbench"), radius: 0.45),
    (id: "torch",      shape: "torch",      hp: 0.5, drops: Some("torch"), solid: false, light: Some(6.0), xp: 0.0),
    // Decor: walkable, breaks instantly, no drops. Scattered by worldgen for texture.
    (id: "grass_tuft",   shape: "grass_tuft",   hp: 0.1, solid: false, xp: 0.0),
    (id: "flower_white", shape: "flower_white", hp: 0.1, solid: false, xp: 0.0),
    (id: "flower_red",   shape: "flower_red",   hp: 0.1, solid: false, xp: 0.0),
    (id: "pebbles",      shape: "pebbles",      hp: 0.1, solid: false, xp: 0.0, drops: Some("pebbles")),
    (id: "mushroom",     shape: "mushroom",     hp: 0.1, solid: false, xp: 0.0, drops: Some("mushroom")),
    (id: "reeds",        shape: "reeds",        hp: 0.2, solid: false, xp: 0.0, drops: Some("reeds")),
    (id: "shell_deco",   shape: "shell_deco",   hp: 0.1, solid: false, xp: 0.0),

    // Crops: each stage grows into the next after `secs`; the last stage is harvested by hand.
    (id: "wheat_1", shape: "wheat_1", hp: 0.3, solid: false, xp: 0.0, on: Some(["tilled"]), grows_into: Some(("wheat_2", 90.0))),
    (id: "wheat_2", shape: "wheat_2", hp: 0.3, solid: false, xp: 0.0, grows_into: Some(("wheat_3", 90.0))),
    (id: "wheat_3", shape: "wheat_3", hp: 0.3, solid: false, xp: 2.0, drops: Some("wheat")),
    (id: "furnace",    shape: "furnace",    hp: 4.0, drops: Some("furnace"), station: Some("furnace"), tool: Some("pickaxe")),
]
