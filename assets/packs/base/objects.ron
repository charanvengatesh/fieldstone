    (id: "shrine_0", shape: "shrine_0", hp: 6.0, drops: Some("shrine"), tool: Some("pickaxe"), use_swaps: Some("shrine_1"), use_consumes: Some("sun_core")),
    (id: "shrine_1", shape: "shrine_1", hp: 6.0, drops: Some("shrine_1"), tool: Some("pickaxe"), use_swaps: Some("shrine_2"), use_consumes: Some("sun_core"), light: Some(4.0)),
    (id: "shrine_2", shape: "shrine_2", hp: 6.0, drops: Some("shrine_2"), tool: Some("pickaxe"), use_swaps: Some("shrine_3"), use_consumes: Some("sun_core"), light: Some(6.0)),
    (id: "shrine_3", shape: "shrine_3", hp: 9.0, drops: Some("shrine_3"), tool: Some("pickaxe"), light: Some(14.0)),
    (id: "campfire",   shape: "campfire",   hp: 1.0, drops: Some("campfire"), solid: false, station: Some("fire"), light: Some(4.0)),
    (id: "furnace",    shape: "furnace",    hp: 4.0, drops: Some("furnace"), station: Some("furnace"), tool: Some("pickaxe")),
