// One-shot guidance. Each fires once, in file order, when its trigger first holds and no other
// toast is showing. Mods can add hints or redefine these by id.
[
    (id: "start",    when: After(7.0),         text: "Click a tree to chop it. You walk there yourself.", secs: 7.0),
    (id: "food",     when: After(60.0),        text: "The amber bar is food. Berries, mushrooms, fish, or cook meat at a campfire (3 sticks + 1 stone).", secs: 8.0),
    (id: "logs",     when: HasItem("log"),     text: "Logs! Press C to craft planks, then sticks, then a workbench.", secs: 7.0),
    (id: "bench",    when: HasItem("workbench"), text: "Press F on open ground to place the workbench, then craft next to it.", secs: 7.0),
    (id: "placed",   when: Placed("workbench"), text: "Tools need a workbench nearby. Try a pickaxe for the ore in the hills.", secs: 7.0),
    (id: "stone",    when: HasItem("stone"),   text: "Stone walls and a furnace come from stone. Torches keep the night calm.", secs: 7.0),
    (id: "night",    when: Night,              text: "Night. Things wake up. Stay near torches, or carry a sword.", secs: 7.0),
    (id: "day2",     when: Day(1),             text: "A chest keeps your haul; a bed sets your respawn and skips the dark.", secs: 7.0),
    (id: "gold",     when: HasItem("gold_ore"), text: "Gold. Eight stone and two gold make a Sun Shrine. Three Sun Cores end the night for good.", secs: 8.0),
    (id: "shelter",  when: Indoors,            text: "Shelter. Nothing spawns inside walls you close.", secs: 6.0),
    (id: "level",    when: Level(2),           text: "Level up: more health, harder hits. Skills grow with what you do.", secs: 6.0),
]
