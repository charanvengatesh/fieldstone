// The terrain: a height field in `low..=high`, flooded below `sea`, with a surface block
// chosen by height. Trees, ore and other additions are separate records in features.ron.
[(
    id: "default",
    height: (scale: 72.0, octaves: 4, low: 4, high: 22),
    sea: 9,
    sea_block: "water",
    bands: [
        (max: 10, surface: "sand",  under: "sand"),
        (max: 17, surface: "grass", under: "dirt"),
        (max: 20, surface: "stone", under: "stone"),
        (max: 99, surface: "snow",  under: "stone"),
    ],
    under_depth: 3,
    base: "stone",
    floor: "bedrock",
)]
