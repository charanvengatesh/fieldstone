// Vector art. Parts draw in order (first is bottom). Sizes and offsets are in cells; 1.0 = one tile.
// Convention: a soft "shadow" first, then an "ink" outline slightly larger than the body, then
// the body and highlights. Item shapes get a thinner outline so they read at icon size.
[
    (id: "player", parts: [
        Circle(r: 0.30, color: "shadow", at: (0.04, -0.08)),
        Circle(r: 0.32, color: "ink"),
        Circle(r: 0.28, color: "pebble"),
        Circle(r: 0.12, color: "white", at: (-0.06, 0.10)),
        Circle(r: 0.06, color: "pebble_dark", at: (0.14, 0.10)),
        Circle(r: 0.06, color: "pebble_dark", at: (0.14, -0.10)),
        Circle(r: 0.025, color: "white", at: (0.16, 0.12)),
        Circle(r: 0.025, color: "white", at: (0.16, -0.08)),
    ]),

    // ---- World objects ----
