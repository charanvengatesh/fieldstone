// Hand-drawn stamps the generator drops into the world (see `scatter` rules in
// worldgen.ron with a `structure:` field). `rows` run north to south; every character must be
// in `legend` except a space, which leaves the generated cell as it was. `loot` fills storage
// objects in the stamp when the chunk is first generated.
[
    (id: "campsite",
        rows: [
            "s . ",
            " f c",
            ". s ",
        ],
        legend: {
            's': Object("stump"),
            'f': Object("campfire"),
            'c': Object("chest"),
            '.': Clear,
        },
        loot: Some("campsite_chest")),
]
