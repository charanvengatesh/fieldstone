// Additions to the terrain. Each record is merged by id, so a mod adds its own rules (or
// replaces one of these) without touching worldgen.ron.
//   Surface: stand a stamp on dry columns whose surface block is listed in `on`.
//   Replace: swap one block for another inside the ground, between two heights.
// `noise: Some((cells per noise cell, threshold))` keeps a rule to patches: groves, veins.
[
    (id: "forest",     rule: Surface(stamp: "tree", on: ["grass"], density: 0.16, noise: Some((28.0, 0.56)))),
    (id: "tall_trees", rule: Surface(stamp: "tall_tree", on: ["grass"], density: 0.05, noise: Some((28.0, 0.60)))),
    (id: "lone_trees", rule: Surface(stamp: "tree", on: ["grass"], density: 0.004)),
    (id: "boulders",   rule: Surface(stamp: "boulder", on: ["grass", "stone"], density: 0.004)),
    (id: "coal",       rule: Replace(block: "stone", with: "coal_ore", density: 0.8, noise: Some((5.0, 0.70)), z: (1, 20))),
    (id: "iron",       rule: Replace(block: "stone", with: "iron_ore", density: 0.8, noise: Some((4.0, 0.76)), z: (1, 12))),
]
