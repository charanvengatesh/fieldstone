// Drop tables. Each entry rolls independently: `chance` to drop, then `min..=max` of the item.
[
    (id: "tree",       entries: [ (item: "log", min: 1, max: 3), (item: "stick", min: 1, max: 2, chance: 0.6) ]),
    (id: "bush",       entries: [ (item: "stick", min: 1, max: 2, chance: 0.7), (item: "berries", min: 1, max: 3) ]),
    (id: "rock",       entries: [ (item: "stone", min: 1, max: 2) ]),
    (id: "iron_ore",   entries: [ (item: "iron_ore", min: 1, max: 2), (item: "stone", chance: 0.5) ]),
    (id: "coal_ore",   entries: [ (item: "coal", min: 1, max: 3), (item: "stone", chance: 0.5) ]),
    (id: "gold_ore",   entries: [ (item: "gold_ore"), (item: "stone", chance: 0.5) ]),
    (id: "wall_wood",  entries: [ (item: "wall_wood") ]),
    (id: "wall_stone", entries: [ (item: "wall_stone") ]),
    (id: "workbench",  entries: [ (item: "workbench") ]),
    (id: "furnace",    entries: [ (item: "furnace") ]),
    (id: "torch",      entries: [ (item: "torch") ]),

    (id: "boar",       entries: [ (item: "meat", min: 1, max: 2), (item: "hide", chance: 0.6) ]),
    (id: "slime",      entries: [ (item: "goo", min: 1, max: 2) ]),
    (id: "wolf",       entries: [ (item: "meat", min: 1, max: 2), (item: "hide", min: 1, max: 2) ]),
    (id: "rock_crab",  entries: [ (item: "shell"), (item: "stone", chance: 0.5) ]),
]
