// Every cube in the base world. Each block's two 16 x 16 tiles (top and sides) are drawn
// from `color`, `top` and `accent` by `pattern`; a pack can replace them with
// textures/<id>_top.png and textures/<id>_side.png. `hp` is seconds to break by hand.
// A block gets an item that places it unless `item: false`.
[
    (id: "bedrock",  name: "Bedrock",  color: (58, 56, 68), pattern: Stone, breakable: false, item: false),
    (id: "stone",    name: "Stone",    color: (132, 134, 142), pattern: Stone, hp: 1.6),
    (id: "dirt",     name: "Dirt",     color: (128, 88, 54), pattern: Grain, hp: 0.5),
    (id: "grass",    name: "Grass",    color: (128, 88, 54), top: Some((96, 168, 70)), pattern: Grass, hp: 0.6, drops: Some("dirt")),
    (id: "sand",     name: "Sand",     color: (218, 198, 138), pattern: Sand, hp: 0.4),
    (id: "snow",     name: "Snow",     color: (228, 234, 242), pattern: Snow, hp: 0.3),
    (id: "water",    name: "Water",    color: (52, 112, 196), pattern: Water, walkable: false, breakable: false, item: false),
    (id: "log",      name: "Log",      color: (104, 72, 44), top: Some((184, 146, 92)), pattern: Log, hp: 0.9),
    (id: "leaves",   name: "Leaves",   color: (62, 132, 60), pattern: Leaves, hp: 0.2),
    (id: "coal_ore", name: "Coal Ore", color: (132, 134, 142), accent: Some((44, 44, 54)), pattern: Ore, hp: 1.8),
    (id: "iron_ore", name: "Iron Ore", color: (132, 134, 142), accent: Some((214, 150, 112)), pattern: Ore, hp: 2.2),
]
