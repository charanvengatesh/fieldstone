    id: "default",
    height_scale: 90.0,
    moisture_scale: 140.0,
    bands: [
        (-0.38, "deep_water"),
        (-0.22, "water"),
        (-0.12, "sand"),
        (0.30, "grass"),
        (2.0, "rock"),
    ],
    wet: [
        ("grass", "forest", 0.12),
        ("grass", "meadow", -0.25),
    ],
    scatter: [
        (object: "oak",         on: ["forest"],          density: 0.03),
        (object: "tree",        on: ["forest"],          density: 0.26),
        (object: "tree",        on: ["grass"],           density: 0.03),
        (object: "bush",        on: ["grass", "meadow"], density: 0.03),
        (object: "rock",        on: ["grass", "meadow"], density: 0.015),
        (object: "rock",        on: ["rock"],            density: 0.10),
        (object: "crystal_ore", on: ["rock"],            density: 0.10, noise: Some((50.0, 0.45))),
        (object: "iron_ore",    on: ["rock"],            density: 0.14, noise: Some((30.0, 0.15))),
        (object: "coal_ore",    on: ["rock"],            density: 0.14, noise: Some((30.0, 0.15))),
        (object: "gold_ore",    on: ["rock"],            density: 0.06, noise: Some((45.0, 0.30))),
        (object: "grass_tuft",   on: ["grass", "meadow"], density: 0.12),
        (object: "flower_white", on: ["meadow"],          density: 0.05),
        (object: "flower_red",   on: ["meadow", "grass"], density: 0.02),
        (object: "mushroom",     on: ["forest"],          density: 0.04),
        (object: "pebbles",      on: ["sand", "rock"],    density: 0.05),
        (object: "shell_deco",   on: ["sand"],            density: 0.03),
        (object: "foam",         on: ["sand"],            density: 0.55, near: Some(["water", "deep_water"])),
        (object: "reeds",        on: ["sand"],            density: 0.18, near: Some(["water"])),
        (object: "lily",         on: ["water"],           density: 0.06, near: Some(["sand"])),
        (object: "ripple",       on: ["water"],           density: 0.03),
        (object: "rock_wet",     on: ["water"],           density: 0.012, near: Some(["sand"])),
        (structure: Some("campsite"), on: ["meadow"], density: 0.003),
