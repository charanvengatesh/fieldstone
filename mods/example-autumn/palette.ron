// Data-only mod: redefines base palette ids, so every tree, bush and field turns to autumn.
// Nothing else changes; this is what a pure retexture looks like.
[
    (id: "grass",      rgb: (150, 142, 62)),
    (id: "meadow",     rgb: (176, 158, 72)),
    (id: "forest",     rgb: (118, 96, 48)),
    (id: "leaf",       rgb: (208, 110, 40)),
    (id: "leaf_dark",  rgb: (150, 70, 30)),
    (id: "leaf_light", rgb: (236, 160, 60)),
    (id: "sprout",     rgb: (190, 150, 70)),
    (id: "reed",       rgb: (170, 140, 70)),
]
